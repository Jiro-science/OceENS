# Copy this file to `.env` (`cp .env.example .env`): the application and
# docker-compose.yaml read it at startup. Each variable is described in the
# README's "Configuration reference" section; the comments below are reminders.

# ┌─ Authentication ──────────────────────────────────────────────────────────┐
# `dev`: development login (GET /dev/login), no identity provider. Anyone can
# log in as any user: NEVER USE IN PRODUCTION.
# `entra` (default when unset): Microsoft Entra ID, see the section below.
# `dev` is shipped here so that a fork starts without Entra credentials: every
# deployment requires `AUTH_MODE` unset or `entra` (README deployment checklist).
AUTH_MODE=dev

# Optional key required by the development login (empty = open login).
# Ignored with AUTH_MODE=entra.
DEV_LOGIN_KEY=

# Allowed e-mail domains, comma-separated.
ALLOWED_DOMAINS=epf.fr,epfedu.fr

# Session cookie signing key. Required with AUTH_MODE=entra, optional with
# AUTH_MODE=dev: see the README's configuration reference.
SECRET_KEY=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Microsoft Entra ID (required with AUTH_MODE=entra) ──────────────────────┐
# Leave commented out in dev mode. Uncomment and fill in all four for
# AUTH_MODE=entra: the application refuses to start if one of the first three
# is missing.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=
# REDIRECT_URI=https://[CHANGE_THIS]/auth/callback
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ Database ────────────────────────────────────────────────────────────────┐
# SQLite database folder (default: database/ at the project root).
# With docker compose, host folder mounted into the container.
LOCAL_DATABASE_DIR=
# └───────────────────────────────────────────────────────────────────────────┘

# ┌─ LLM summaries ───────────────────────────────────────────────────────────┐
# Key of the default LLM provider. Empty: the application starts, but
# requested summaries are marked as a configuration error.
LLM_API_KEY=

# Set to 1 to run the summaries daemon alongside uvicorn.
# Leave empty/unset in production (launch.sh already runs the daemon).
RUN_SUMMARIES_DAEMON=
# └───────────────────────────────────────────────────────────────────────────┘
